---
import { getCollection } from 'astro:content';
import { brand, office, people } from '../data/brand.js';
import { ui, home, practices, network, whyus, contact, trust, cookie } from '../data/content.js';
const { locale = 'hu' } = Astro.props;
const t = ui[locale];
const h = home[locale];
const net = network[locale];
const netUrl = network.url[locale];
const why = whyus[locale];
// Szakterületek stratégiai sorrendje: Kína-desk és a fő üzleti pillérek előre, büntetőjog hátra.
const practiceOrder = ['nemzetkozi-kap','tarsasagi','szerzodesek','nemzetkozi','ingatlanjog','energiajog','versenyjog','szellemi','adatvedelem','kozossegi','karterites','buntetojog'];
const orderedPractices = practiceOrder.map(k => practices.find(p => p.key === k)).filter(Boolean);
const base = locale === 'hu' ? '' : `/${locale}`;
let posts = await getCollection('blog', (p) => p.data.lang === locale && !p.data.draft);
posts = posts.sort((a, b) => b.data.date - a.data.date).slice(0, 4).map((p) => ({
  key: p.data.key, date: p.data.date, title: p.data.title, excerpt: p.data.excerpt,
}));
const viewAll = { hu: 'Összes cikk →', en: 'All insights →', zh: '查看全部 →' }[locale];
const dateFmt = (d) => new Date(d).toLocaleDateString(locale === 'zh' ? 'zh-CN' : locale === 'en' ? 'en-GB' : 'hu-HU', { year: 'numeric', month: 'long', day: 'numeric' });
const initials = (n) => n.replace('dr. ', '').split(' ').map(w => w[0]).join('').slice(0,2).toUpperCase();
---
<!-- HERO -->
<section class="hero">
  <div class="wrap">
    <p class="eyebrow" style="color:var(--gold-soft)">{brand.networkLabel} · {brand.networkParent.zh}</p>
    <h1>{h.heroTitle}</h1>
    <p class="sub">{h.heroSub}</p>
    <a class="cta" href="#contact">{t.contactCta}</a>
  </div>
</section>

<!-- NETWORK (DHH globális háló) — bizonyítéksor közvetlenül a hero alatt -->
<section class="netband">
  <div class="wrap">
    <div class="net-grid">
      <div class="net-lead">
        <p class="eyebrow" style="color:var(--gold-soft)">{net.eyebrow}</p>
        <h2>{net.title}</h2>
        <p class="net-tag">{net.tagline}</p>
        <p class="net-body">{net.body}</p>
        <a class="net-cta" href={netUrl} target="_blank" rel="noopener noreferrer">{net.cta} ↗</a>
      </div>
      <div class="net-stats">
        {net.stats.map(s => (
          <div class="net-stat"><span class="net-n">{s.n}</span><span class="net-l">{s.l}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- TEAM PHOTO BAND -->
<section class="teamband">
  <div class="teamband-frame">
    <img src="/team.jpg" alt={locale==='hu' ? 'A Czudar DHH Ügyvédi Iroda csapata — Budapest' : locale==='en' ? 'The Czudar DHH Law Firm team — Budapest' : '德和衡（匈牙利）律师事务所团队 — 布达佩斯'} />
  </div>
</section>

<!-- VALUES -->
<section>
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{h.valuesTitle}</h2></div>
    <div class="grid g3">
      {h.values.map(v => (
        <div class="card"><h3>{v.t}</h3><p style="color:var(--slate);margin:0">{v.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- ABOUT -->
<section id="about" class="alt">
  <div class="wrap" style="max-width:820px">
    <div class="sec-head"><hr class="hr-gold" /><h2>{h.aboutTitle}</h2></div>
    {h.aboutBody.map(p => <p style="color:var(--slate);font-size:17px">{p}</p>)}
  </div>
</section>

<!-- PRACTICE -->
<section id="practice">
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{h.practiceTitle}</h2></div>
    <div class="grid g3">
      {orderedPractices.map(pr => (
        <div class="card pract"><h3>{pr[locale][0]}</h3><p>{pr[locale][1]}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- WHY US -->
<section id="whyus" class="alt">
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{why.title}</h2></div>
    <div class="grid g2">
      {why.items.map(it => (
        <div class="card"><h3>{it.t}</h3><p style="color:var(--slate);margin:0">{it.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- TRUST (bizalmi jelek) — csak ha published:true (jelenleg gyűjtés alatt, nem publikus) -->
{trust.published && (
<section id="trust">
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{trust.title[locale]}</h2></div>
    <div class="grid g3">
      {[...trust.references, ...trust.rankings, ...trust.memberships, ...trust.press].map(x => (
        <div class="card"><h3>{x.t}</h3>{x.d && <p style="color:var(--slate);margin:0">{x.d}</p>}{x.url && <a href={x.url} target="_blank" rel="noopener">↗</a>}</div>
      ))}
    </div>
  </div>
</section>
)}

<!-- TEAM -->
<section id="team">
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{h.teamTitle}</h2></div>
    <div class="grid g3">
      {people.map(p => (
        <div class="card">
          <div class="person">
            {p.photo ? <img src={p.photo} alt={p.name[locale]} /> : <div class="ph-fallback">{initials(p.name[locale])}</div>}
            <div>
              <h3>{p.name[locale]}</h3>
              <div class="role">{p.title[locale]}</div>
            </div>
          </div>
          <p style="margin-top:14px">{p.bio[locale]}</p>
          <a href={`mailto:${p.email}`}>{p.email}</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- BLOG -->
{posts.length > 0 && (
<section id="blog" class="alt">
  <div class="wrap">
    <div class="sec-head"><hr class="hr-gold" /><h2>{h.blogTitle}</h2></div>
    <div class="grid g2">
      {posts.map(post => (
        <a class="post" href={`${base}/blog/${post.key}`}>
          <span class="date">{dateFmt(post.date)}</span>
          <h3>{post.title}</h3>
          <p>{post.excerpt}</p>
        </a>
      ))}
    </div>
    <p style="text-align:center;margin-top:28px"><a href={`${base}/blog`} style="color:var(--navy);font-weight:600">{viewAll}</a></p>
  </div>
</section>
)}

<!-- PRO BONO -->
<section>
  <div class="wrap" style="max-width:820px;text-align:center">
    <hr class="hr-gold" />
    <h2>{h.proBonoTitle}</h2>
    <p style="color:var(--slate);font-size:17px">{h.proBonoBody}</p>
  </div>
</section>

<!-- CONTACT -->
<section id="contact" class="contact">
  <div class="wrap">
    <div class="sec-head" style="margin-bottom:26px"><hr class="hr-gold" /><h2>{t.contactCta}</h2></div>
    <div class="offices">
      <div class="office">
        <h3>{t.officeBudapest}</h3>
        <p>{office.hqAddress}</p>
        <p><a href={`tel:${office.phoneHref}`}>{office.phone}</a> · <a href={`mailto:${office.email}`}>{office.email}</a></p>
        <div class="office-map map-embed" data-map-src={contact.budapest.map} data-map-title={t.officeBudapest}>
          <div class="map-ph"><p>{cookie.mapNotice[locale]}</p><button type="button" class="map-load">{cookie.mapLoad[locale]}</button></div>
        </div>
        <a class="book-btn" href={contact.budapest.booking} target="_blank" rel="noopener noreferrer">{contact.book[locale]} — Budapest ↗</a>
      </div>
      <div class="office">
        <h3>{t.officeBalassagyarmat}</h3>
        <p>{office.branchAddress}</p>
        <p><a href={`tel:${office.phoneHref}`}>{office.phone}</a> · <a href={`mailto:${office.email}`}>{office.email}</a></p>
        <div class="office-map map-embed" data-map-src={contact.balassagyarmat.map} data-map-title={t.officeBalassagyarmat}>
          <div class="map-ph"><p>{cookie.mapNotice[locale]}</p><button type="button" class="map-load">{cookie.mapLoad[locale]}</button></div>
        </div>
        <a class="book-btn" href={contact.balassagyarmat.booking} target="_blank" rel="noopener noreferrer">{contact.book[locale]} — Balassagyarmat ↗</a>
      </div>
    </div>
    <p style="margin-top:28px;color:#cdd6e6">
      <span style="color:var(--gold-soft);font-weight:600">{contact.followUs[locale]}:</span>
      <a href={contact.social.facebook} target="_blank" rel="noopener">Facebook</a> · <a href={contact.social.instagram} target="_blank" rel="noopener">Instagram</a>
    </p>
  </div>
</section>
