---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
const locale = 'ko';
export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => p.data.lang === 'ko' && !p.data.draft);
  return posts.map((entry) => ({ params: { slug: entry.data.key }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const d = new Date(entry.data.date).toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' });
const by = entry.data.coauthor ? `${entry.data.author} – ${entry.data.coauthor}` : entry.data.author;
---
<Base locale={locale} title={`${entry.data.title} | Czudar DHH 법률사무소`} description={entry.data.excerpt}>
  <article class="article">
    <a class="backlink" href="/ko/blog">← 인사이트 목록으로</a>
    <div class="meta">{d} · {by}</div>
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.excerpt}</p>
    {entry.data.reviewNote && <div class="review">{entry.data.reviewNote}</div>}
    <div class="body"><Content /></div>
    {entry.data.source && <p class="src">최초 게재: {entry.data.source}</p>}
    <p class="src">본 전문 자료는 일반적인 정보 제공을 목적으로 하며, 법률 자문에 해당하지 않습니다.</p>
  </article>
</Base>
