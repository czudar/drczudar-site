---
import Base from '../../layouts/Base.astro';
import { brand, office } from '../../data/brand.js';
import { notice } from '../../data/content.js';
// 数据处理告知书 — 2026/2（自2026-10-12起生效）。本页是经 MP 批准的匈牙利文最终文本
// （src/pages/adatkezelesi-tajekoztato.astro）的忠实译文；内容修改仅可依据新批准的匈牙利文文本进行。
const locale = 'zh';
const name = brand.name[locale];
const mail = `mailto:${office.email}`;
---
<Base locale={locale} alternates={notice.path} title={`${notice.title[locale]} | ${name}`} description={`${name}的数据处理告知书（2026/2）：处理的个人数据、数据处理的目的和法律依据、保存期限、数据处理者、数据主体的权利及法律救济。`}>
  <article class="article notice">
    <a class="backlink" href="/zh/">← 返回首页</a>
    <h1>数据处理告知书</h1>
    <p class="meta"><em>自2026年10月12日起生效 · 版本：2026/2 · 上一版本自2026年9月20日起生效。</em></p>
    <div class="body">

      <h2 id="s1">1. 数据控制者</h2>
      <p><strong>{brand.name.hu}</strong>（{name}；以下简称“本所”）</p>
      <ul>
        <li>注册地址：1054 Budapest, Szemere utca 23. I/1.</li>
        <li>分所：{office.branchAddress}</li>
        <li>律师公会登记：{office.bar}（布达佩斯律师公会），{office.barRegNo}</li>
        <li>税号：19322016-2-41</li>
        <li>电子邮箱：<a href={mail}>{office.email}</a></li>
        <li>电话：{office.phone}</li>
        <li>企业电子信箱（Cégkapu）：19322016#cegkapu</li>
      </ul>
      <p><strong>数据保护官。</strong>依据《通用数据保护条例》（欧洲议会和理事会第(EU) 2016/679号条例，以下简称“GDPR”）第37条，本所无义务指定数据保护官，亦未指定。有关数据保护事宜，可通过上述联系方式与本所联系。</p>

      <h2 id="s2">2. 本告知书的适用范围</h2>
      <p>本告知书适用于本所处理的个人数据，尤其是</p>
      <ul class="alpha">
        <li><strong>a)</strong> 网站访问者以及与本所取得联系者（咨询、预约）的数据；</li>
        <li><strong>b)</strong> 本所客户及其代表人和联系人的数据；</li>
        <li><strong>c)</strong> 在履行委托过程中知悉的其他人的数据，尤其是对方当事人、证人、合同相对方、受益所有人和被授权人的数据。</li>
      </ul>
      <p>对 a)–b) 项所列数据主体的告知，适用 GDPR 第13条；对 c) 项所列数据主体的告知，适用 GDPR 第14条；告知的限制载于第9节。</p>

      <h2 id="s3">3. 律师职业秘密</h2>
      <p>本所在从事律师执业活动过程中知悉的一切事实、信息和数据，均属于律师职业秘密。保密义务在律师执业活动结束及委托终止后仍无期限地存续（《律师执业法》（2017年第LXXVIII号法律，以下简称“Üttv.”）第9条第(1)、(2)和(4)款）。</p>

      <h2 id="s4">4. 各项数据处理</h2>

      <h3 id="s4-1">4.1. 咨询（电子邮件、电话）</h3>
      <ul>
        <li><strong>处理的数据：</strong>姓名、电子邮箱地址、电话号码、信息内容。</li>
        <li><strong>目的：</strong>答复咨询、为委托作准备。</li>
        <li><strong>法律依据：</strong>应数据主体的请求在订立合同前采取措施（GDPR 第6条第(1)款(b)项）。</li>
        <li><strong>保存期限：</strong>
          <ul>
            <li>未成立委托的，自咨询办结之日起一年；</li>
            <li>成立委托的，依第4.5节的规定。</li>
          </ul>
        </li>
      </ul>

      <h3 id="s4-2">4.2. 在线预约</h3>
      <ul>
        <li><strong>处理的数据：</strong>姓名、联系方式、预约的时间和事由。</li>
        <li><strong>工具：</strong>预约通过 Google 日历服务进行；Google 作为数据处理者行事。</li>
        <li><strong>法律依据：</strong>GDPR 第6条第(1)款(b)项。</li>
        <li><strong>保存期限：</strong>依第4.1节的规定。</li>
      </ul>

      <h3 id="s4-3">4.3. 客户身份识别</h3>
      <p><strong>委托前的身份识别。</strong>除就法律咨询所作的委托外，本所在订立委托合同前，对客户及代表其行事的人进行身份识别。对于本所不认识的自然人，或者本所对其身份存有疑问的自然人，本所以下列方式之一进行身份识别（Üttv. 第32条第(1)–(2)款）：</p>
      <ul>
        <li>查验其适于证明身份的证件；或</li>
        <li>采用法律规定的电子身份识别方式。</li>
      </ul>
      <p><strong>律师副署前的身份识别。</strong>在对作为具有公信力的登记簿登记依据的文书进行律师副署之前，本所对所有作出意思表示的人或组织及其代表人进行身份识别（Üttv. 第32条第(7)款）。</p>
      <p><strong>通过登记簿进行核验。</strong>为核验证件的有效性及数据的一致性，本所可以电子方式向法律规定的具有公信力的登记簿调取数据（Üttv. 第32条第(3)款）。此类数据可以是：</p>
      <ul>
        <li>自然人身份识别数据；</li>
        <li>国籍；</li>
        <li>住址；</li>
        <li>面部肖像；</li>
        <li>签名；</li>
        <li>证件数据。</li>
      </ul>
      <p><strong>法律依据：</strong>履行法定义务（GDPR 第6条第(1)款(c)项；Üttv. 第32条）。</p>

      <h3 id="s4-4">4.4. 客户登记与客户尽职调查</h3>
      <p><strong>客户登记。</strong>在必须由法律代理人代理的案件中，本所对已识别身份的自然人、法人及其他组织进行登记（Üttv. 第33条第(1)款）。登记的数据（Üttv. 第33条第(2)和(4)款）：</p>
      <ul>
        <li><strong>自然人：</strong>
          <ul>
            <li>自然人身份识别数据；</li>
            <li>住址；</li>
            <li>国籍或法律身份；</li>
            <li>身份证件的种类和号码；</li>
            <li>电子数据调取的识别号；</li>
            <li>案件识别号；</li>
          </ul>
        </li>
        <li><strong>组织：</strong>
          <ul>
            <li>名称和注册地址；</li>
            <li>公司注册号或登记号；</li>
            <li>代表人的身份识别数据；</li>
            <li>案件识别号；</li>
          </ul>
        </li>
        <li><strong>两种情形下均包括：</strong>关于预防洗钱的法律所规定的数据。</li>
      </ul>
      <p><strong>客户尽职调查。</strong>在属于《预防和打击洗钱及恐怖主义融资法》（2017年第LIII号法律，以下简称“Pmt.”）适用范围的案件中，本所进行客户尽职调查。其内容包括：</p>
      <ul>
        <li>确定受益所有人；</li>
        <li>审查是否具有政治公众人物身份；</li>
        <li>核查制裁名单。</li>
      </ul>
      <p>客户在尽职调查过程中所作的声明，由本所记录于专门的数据表。</p>
      <p><strong>法律依据：</strong>履行法定义务（GDPR 第6条第(1)款(c)项；Üttv. 第33条；Pmt.）。</p>
      <p><strong>保存期限：</strong></p>
      <ul>
        <li>自业务关系终止或交易委托履行完毕之日起<strong>八年</strong>（Pmt. 第56条第(2)款、第57条第(2)款；Üttv. 第33条第(7)款）；</li>
        <li>应有权机关的要求，最长<strong>十年</strong>（Pmt. 第58条第(1)款）。</li>
      </ul>
      <p>保存期限届满后，本所立即删除数据并销毁文书（Pmt. 第57条第(4)款）。</p>

      <h3 id="s4-5">4.5. 案件登记、委托的履行与文件的保存</h3>

      <h4 id="s4-5-a">案件登记</h4>
      <p>本所对基于委托办理的案件进行登记（Üttv. 第53条第(1)款）。登记的数据：</p>
      <ul>
        <li>案件识别号；</li>
        <li>客户的姓名或名称；</li>
        <li>案件事由；</li>
        <li>委托合同成立的时间；</li>
        <li>相关程序的案号或收文编号。</li>
      </ul>
      <p>本所在下列期限内处理登记的数据（Üttv. 第53条第(3)款）：</p>
      <ul>
        <li>委托终止后<strong>五年</strong>；</li>
        <li>对文书进行律师副署的，副署后<strong>十年</strong>；</li>
        <li>在涉及不动产权利于具有公信力的登记簿中登记的案件中，自权利登记之日起<strong>十年</strong>。</li>
      </ul>
      <p>实施律师公会的监管检查的人员或机构、替代律师以及事务所管理人（irodagondnok）可以查阅该登记。</p>

      <h4 id="s4-5-b">委托的履行</h4>
      <p>包括案件办理、代理、文书起草和咨询。</p>
      <ul>
        <li><strong>处理的数据：</strong>身份识别数据和联系数据，以及客户提供的或案件文件中载明的、为履行委托所必需的一切数据。</li>
        <li><strong>法律依据：</strong>
          <ul>
            <li>客户为自然人的，履行合同（GDPR 第6条第(1)款(b)项）；</li>
            <li>对于法人或其他组织客户的代表人和联系人，本所与客户在履行委托所必需的联络方面的正当利益（GDPR 第6条第(1)款(f)项）；</li>
            <li>在法律规定的文件管理和登记范围内，履行法定义务（GDPR 第6条第(1)款(c)项）。</li>
          </ul>
        </li>
        <li><strong>特殊类别个人数据</strong>（例如健康数据）：本所在提出、行使或抗辩法律主张所必需的范围内处理此类数据（GDPR 第9条第(2)款(f)项）。</li>
        <li><strong>与刑事定罪和犯罪有关的个人数据：</strong>本所仅在其辩护人或法律代理人活动的范围内处理此类数据。该处理依据《刑事诉讼法》（2017年第XC号法律）和 Üttv. 的授权，在律师保密义务的保障下进行（GDPR 第10条）。</li>
      </ul>

      <h4 id="s4-5-c">文件的保存</h4>
      <p>经律师副署的文书以及在涉及文书副署的案件中形成的其他文件，本所自副署之日起保存<strong>十年</strong>（Üttv. 第53条第(5)款）。</p>
      <p>除此之外，本所依照委托合同中载明的销毁规程，并与 Magyar Ügyvédi Kamara（匈牙利全国律师公会）的文件管理规则相一致，保存案件文件：</p>
      <ul>
        <li>案件中对作为具有公信力的登记簿登记依据的文书进行了律师副署的：至自委托终止之日起算的<strong>第11年的3月31日</strong>；</li>
        <li>在诉讼程序中代理的：至自委托终止之日起算的<strong>第6年的3月31日</strong>；</li>
        <li>其他案件，尤其是咨询或出具法律意见的：至自委托终止之日起算的<strong>第2年的3月31日</strong>；</li>
        <li>遗嘱处分的：至遗产移交裁定发生法律效力后的<strong>第6年的3月31日</strong>。</li>
      </ul>
      <p>保存期限届满后，本所删除或销毁文件和个人数据。但法律、法律规定的登记的管理，或者法律主张的行使或抗辩使继续处理成为必要的，不在此限。</p>

      <h3 id="s4-6">4.6. 委托过程中知悉的第三人数据</h3>
      <ul>
        <li><strong>数据主体：</strong>对方当事人、证人、合同相对方、受益所有人、被授权人，以及案件文件中出现的其他人。</li>
        <li><strong>数据来源：</strong>
          <ul>
            <li>客户；</li>
            <li>行政机关和法院的文件；</li>
            <li>具有公信力的登记簿。</li>
          </ul>
        </li>
        <li><strong>法律依据：</strong>
          <ul>
            <li>客户和本所在行使和保护客户权利方面的正当利益（GDPR 第6条第(1)款(f)项）；</li>
            <li>存在法定义务的，GDPR 第6条第(1)款(c)项；</li>
            <li>涉及特殊类别个人数据的，GDPR 第9条第(2)款(f)项。</li>
          </ul>
        </li>
        <li><strong>保存期限：</strong>依第4.5节的规定。</li>
        <li><strong>告知：</strong>本所不对上述人员逐一告知，因为其数据依律师保密义务属于保密信息（GDPR 第14条第(5)款(d)项）。</li>
      </ul>

      <h3 id="s4-7">4.7. 安全凭证</h3>
      <p>本所对用于文书律师副署的安全凭证进行法律规定的登记。</p>
      <ul>
        <li><strong>法律依据：</strong>履行法定义务（GDPR 第6条第(1)款(c)项）。</li>
        <li><strong>保存期限：</strong>法律规定的期限。</li>
      </ul>

      <h3 id="s4-8">4.8. 律师托管（ügyvédi letét）</h3>
      <p>本所办理律师托管的，对托管合同、交存人及受益人的身份识别数据以及与托管有关的数据，按照下列方式处理：</p>
      <ul>
        <li>记载于 Üttv. 及 Magyar Ügyvédi Kamara 托管管理规章所规定的登记；</li>
        <li>履行法律规定的申报义务。</li>
      </ul>
      <p>托管管理由地方律师公会监督检查，其在此范围内可以查阅托管账户的数据（Üttv. 第187条第(2)款）。</p>
      <ul>
        <li><strong>法律依据：</strong>履行法定义务和履行托管合同（GDPR 第6条第(1)款(b)和(c)项）。</li>
        <li><strong>保存期限：</strong>
          <ul>
            <li>托管合同，自合同终止之日起<strong>十年</strong>；</li>
            <li>交付托管的文件，至托管终止时。</li>
          </ul>
        </li>
      </ul>

      <h3 id="s4-9">4.9. 开票与记账</h3>
      <ul>
        <li><strong>处理的数据：</strong>开票名称和地址、税号、与费用有关的数据。</li>
        <li><strong>法律依据：</strong>履行法定义务（GDPR 第6条第(1)款(c)项；《会计法》（2000年第C号法律）；《增值税法》（2007年第CXXVII号法律））。</li>
        <li><strong>保存期限：</strong>至少<strong>八年</strong>（《会计法》第169条第(2)款）。</li>
      </ul>

      <h3 id="s4-10">4.10. 网站的运行</h3>
      <p><strong>网站托管与服务器日志。</strong>本网站由 GitHub, Inc.（美国）通过 GitHub Pages 服务及其内容分发网络提供。常规服务器日志由 GitHub 依其自身的数据处理声明处理；本所无法访问这些日志。日志数据：</p>
      <ul>
        <li>IP 地址；</li>
        <li>时间；</li>
        <li>所请求的页面；</li>
        <li>浏览器数据。</li>
      </ul>
      <p>法律依据：在网站安全运行方面的正当利益（GDPR 第6条第(1)款(f)项）。</p>
      <p><strong>嵌入式地图。</strong>Google 地图仅在访问者同意后加载（GDPR 第6条第(1)款(a)项）。同意可随时撤回。</p>
      <p><strong>Cookie。</strong>本所不设置自有 Cookie，仅在浏览器中存储访问者的 Cookie 选择。该选择可在页脚的“Cookie 设置”项中更改。</p>
      <p><strong>社交媒体页面。</strong>对于指向社交媒体页面的链接，适用相应服务提供者的数据处理规则。</p>

      <h2 id="s5">5. 基于人工智能的工具</h2>
      <p>本所在办理委托过程中，使用基于人工智能的软件工具为工作提供准备和支持。</p>
      <ul>
        <li>这些工具不作出对数据主体产生法律效力或对其产生类似重大影响的、完全自动化的决定（GDPR 第22条）。</li>
        <li>一切实质性决定和律师工作成果均由律师批准。</li>
        <li>专业责任和法律责任，以及保守律师职业秘密的义务，完全由本所承担。</li>
      </ul>
      <p><strong>适用范围：</strong></p>
      <ul>
        <li>文件和案件数据的整理与登记；</li>
        <li>期限的准备（由两名律师确认）；</li>
        <li>内部摘要和文本草稿的准备。</li>
      </ul>
      <p><strong>保障措施：</strong></p>
      <ul>
        <li>对于构成律师职业秘密的数据，本所仅向符合下列条件的服务提供者开放：本所已与其订立数据处理协议，且其合同条款将数据的使用限于提供服务，并排除将数据用于模型训练；</li>
        <li>服务提供者仅可在合同载明的条件下并在本所的监督下使用其他数据处理者；</li>
        <li>对于构成律师职业秘密的数据，本所不使用以输入数据进行学习的公开人工智能服务；</li>
        <li>客户名称、信函内容、个人数据和金额不进入本所系统的日志。</li>
      </ul>
      <p>对于作为数据处理者使用的协助人，在其提供服务所必需的范围内，本所不负保密义务（Üttv. 第10条第(4)款(a)项）。</p>
      <p><strong>录音。</strong>仅在事先明确告知数据主体且其以有记录的方式对此表示同意的情况下，方对客户谈话进行录音或据此制作机器转写文本（GDPR 第6条第(1)款(a)项）。未经同意的，不进行录音。</p>
      <p><strong>不使用人工智能。</strong>客户可以书面形式（<a href={mail}>{office.email}</a>）要求本所在其案件中不使用基于人工智能的工具。</p>

      <h2 id="s6">6. 数据处理者</h2>
      <table>
        <thead>
          <tr><th>数据处理者</th><th>活动</th><th>数据处理地点、传输</th><th>保障措施</th></tr>
        </thead>
        <tbody>
          <tr><td>Google Ireland Ltd.</td><td>电子邮件、文件存储、日历、预约、地图（Google Workspace）</td><td>欧盟；可能向第三国传输</td><td>数据处理附录（Cloud Data Processing Addendum）；标准数据保护条款、欧盟—美国数据隐私框架</td></tr>
